{
  "metadata": {
    "benchmark_name": "QNU Library Assistant Standard Benchmark (QNU-LAB)",
    "version": "2.0.0",
    "description": "Bộ tiêu chuẩn đánh giá toàn diện năng lực Chatbot Thư viện QNU: Phân loại ý định, Tra cứu thư mục BM25, Trích xuất thực thể, Dialogue State Tracking (DST), Nhận diện chuyên ngành, Teen-code sinh viên, An toàn đối kháng và SLA hiệu năng.",
    "endpoint": "http://127.0.0.1:8001/chat",
    "max_total_score": 100.0,
    "passing_score": 80.0,
    "excellent_score": 90.0,
    "rubric_weights": {
      "intent_classification": 20.0,
      "retrieval_relevance": 30.0,
      "constraint_adherence": 20.0,
      "factuality_and_safety": 20.0,
      "latency_sla": 10.0
    }
  },
  "test_cases": [
    {
      "id": "TC_PREF_001",
      "category": "TITLE_SEARCH",
      "name": "Bóc tách tiền tố trường Excel 'nhan đề : '",
      "difficulty": "Easy",
      "weight": 5.0,
      "multi_turn": false,
      "turns": [
        {
          "turn_index": 1,
          "request": {
            "query": "nhan đề : The Cambridge English Course 2"
          },
          "expected": {
            "expected_intent": "catalog_search",
            "min_sources": 1,
            "must_contain": ["Cambridge", "Course 2"],
            "must_not_contain": ["Mình là trợ lý Thư viện, mình có thể giúp bạn: •"],
            "sla_max_ms": 3000
